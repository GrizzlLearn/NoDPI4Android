+/* Called on the native event-loop thread before a flow opens its SOCKS connection. */
+static int
+call_java_route (int protocol, const char *source, int source_port,
+                   const char *destination, int destination_port)
+{
+    JNIEnv *env = NULL;
+    jstring src, dst;
+    jint result;
+    if (!java_vm) return 0; /* Standalone Android executable has no JVM. */
+    if ((*java_vm)->GetEnv(java_vm, (void **)&env, JNI_VERSION_1_4) != JNI_OK) {
+        if ((*java_vm)->AttachCurrentThreadAsDaemon(java_vm, &env, NULL) != JNI_OK) return -1;
+        pthread_setspecific(current_jni_env, env);
+    }
+    src = (*env)->NewStringUTF(env, source);
+    dst = (*env)->NewStringUTF(env, destination);
+    if (!src || !dst) {
+        if (src) (*env)->DeleteLocalRef(env, src);
+        if (dst) (*env)->DeleteLocalRef(env, dst);
+        (*env)->ExceptionClear(env);
+        return -1;
+    }
+    result = (*env)->CallStaticIntMethod(env, routing_class, routing_method,
+                                       protocol, src, source_port, dst, destination_port);
+    (*env)->DeleteLocalRef(env, src);
+    (*env)->DeleteLocalRef(env, dst);
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionClear(env);
+        return -1;
+    }
+    return result >= 0 && result <= 65535 ? result : -1;
+}
+
+/* JNI must execute on an ordinary pthread stack, never Hev's coroutine stack. */
+static pthread_mutex_t route_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t route_request = PTHREAD_COND_INITIALIZER;
+static pthread_cond_t route_done = PTHREAD_COND_INITIALIZER;
+static pthread_once_t route_once = PTHREAD_ONCE_INIT;
+static int route_ready, route_busy, route_pending, route_complete, route_result;
+static int route_protocol, route_source_port, route_destination_port;
+static char route_source[64], route_destination[64];
+
+static void *
+route_worker (void *unused)
+{
+    for (;;) {
+        int protocol, source_port, destination_port, result;
+        char source[64], destination[64];
+        pthread_mutex_lock(&route_mutex);
+        while (!route_pending) pthread_cond_wait(&route_request, &route_mutex);
+        protocol = route_protocol;
+        source_port = route_source_port;
+        destination_port = route_destination_port;
+        memcpy(source, route_source, sizeof(source));
+        memcpy(destination, route_destination, sizeof(destination));
+        route_pending = 0;
+        pthread_mutex_unlock(&route_mutex);
+        result = call_java_route(protocol, source, source_port, destination, destination_port);
+        pthread_mutex_lock(&route_mutex);
+        route_result = result;
+        route_complete = 1;
+        pthread_cond_broadcast(&route_done);
+        pthread_mutex_unlock(&route_mutex);
+    }
+    return NULL;
+}
+
+static void
+start_route_worker (void)
+{
+    pthread_t thread;
+    if (pthread_create(&thread, NULL, route_worker, NULL) == 0) {
+        pthread_detach(thread);
+        route_ready = 1;
+    }
+}
+
+int
+nodpi_select_port (int protocol, const char *source, int source_port,
+                   const char *destination, int destination_port)
+{
+    int result;
+    if (!java_vm) return 0;
+    pthread_once(&route_once, start_route_worker);
+    if (!route_ready) return -1;
+    pthread_mutex_lock(&route_mutex);
+    while (route_busy) pthread_cond_wait(&route_done, &route_mutex);
+    route_busy = 1;
+    route_protocol = protocol;
+    route_source_port = source_port;
+    route_destination_port = destination_port;
+    snprintf(route_source, sizeof(route_source), "%s", source);
+    snprintf(route_destination, sizeof(route_destination), "%s", destination);
+    route_complete = 0;
+    route_pending = 1;
+    pthread_cond_signal(&route_request);
+    while (!route_complete) pthread_cond_wait(&route_done, &route_mutex);
+    result = route_result;
+    route_busy = 0;
+    pthread_cond_broadcast(&route_done);
+    pthread_mutex_unlock(&route_mutex);
+    return result;
+}
